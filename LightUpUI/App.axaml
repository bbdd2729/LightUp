<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:LightUpUI.Converters"
             x:Class="LightUpUI.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <converters:LauncherItemIconConverter x:Key="LauncherItemIconConverter"/>
        <converters:TileItemIconConverter x:Key="TileItemIconConverter"/>
        <converters:LauncherItemNativeIconConverter x:Key="LauncherItemNativeIconConverter"/>
        <converters:TileItemNativeIconConverter x:Key="TileItemNativeIconConverter"/>
        <converters:LauncherItemLabelConverter x:Key="LauncherItemLabelConverter"/>
        <SolidColorBrush x:Key="LightUpWindowBrush" Color="#F0141A27"/>
        <SolidColorBrush x:Key="LightUpSurfaceBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="LightUpSurfaceStrongBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="LightUpBorderBrush" Color="#32FFFFFF"/>
        <SolidColorBrush x:Key="LightUpBorderBrushStrong" Color="#5AFFFFFF"/>
        <SolidColorBrush x:Key="LightUpTextBrush" Color="#FFF7FAFC"/>
        <SolidColorBrush x:Key="LightUpTextMutedBrush" Color="#A8C1CBD6"/>
        <SolidColorBrush x:Key="LightUpTextFaintBrush" Color="#7596A6B5"/>
        <SolidColorBrush x:Key="LightUpAccentBrush" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="LightUpAccentForegroundBrush" Color="#FF08131C"/>
        <SolidColorBrush x:Key="LightUpAccentSoftBrush" Color="#304CC2FF"/>
        <SolidColorBrush x:Key="LightUpSelectionBrush" Color="#3A4CC2FF"/>
        <SolidColorBrush x:Key="LightUpHoverBrush" Color="#20FFFFFF"/>
        <SolidColorBrush x:Key="LightUpDangerBrush" Color="#FFE66D75"/>
        <SolidColorBrush x:Key="LightUpDangerSoftBrush" Color="#20E66D75"/>
        <SolidColorBrush x:Key="LightUpSuccessBrush" Color="#FF76E3A1"/>
        <SolidColorBrush x:Key="LightUpWarningBrush" Color="#FFFFD166"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <Style Selector="Button.launcher-chrome">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Button.launcher-chrome:pointerover">
            <Setter Property="Background" Value="{DynamicResource LightUpSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
        </Style>
        <Style Selector="Button.launcher-chrome:pressed">
            <Setter Property="Background" Value="{DynamicResource LightUpAccentSoftBrush}"/>
        </Style>
        <Style Selector="Button.launcher-primary">
            <Setter Property="Background" Value="{DynamicResource LightUpAccentSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.launcher-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpAccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.launcher-primary:pressed">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>
        <Style Selector="Button.launcher-danger">
            <Setter Property="Background" Value="{DynamicResource LightUpDangerSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpDangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpDangerBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.launcher-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource LightUpDangerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpAccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.launcher-danger:pressed">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>
        <Style Selector="Border.launcher-search-shell">
            <Setter Property="Background" Value="{DynamicResource LightUpSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.launcher-search-clear">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style Selector="Button.launcher-tile-remove">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextFaintBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.launcher-tile-remove:pointerover">
            <Setter Property="Background" Value="#20E66D75"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpDangerBrush}"/>
        </Style>
        <Style Selector="Button.launcher-tile-remove:pressed">
            <Setter Property="Opacity" Value="0.72"/>
        </Style>
        <Style Selector="Button.launcher-chrome:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.tray-menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
        </Style>
        <Style Selector="Button.tray-menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource LightUpHoverBrush}"/>
        </Style>
        <Style Selector="Button.tray-menu-item:pressed">
            <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
        </Style>
        <Style Selector="Button.tray-menu-item:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.tray-menu-exit:pointerover">
            <Setter Property="Background" Value="{DynamicResource LightUpDangerSoftBrush}"/>
        </Style>
        <Style Selector="TextBox.launcher-query">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource LightUpSelectionBrush}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource LightUpTextBrush}"/>
        </Style>
        <Style Selector="TextBox.launcher-query:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource LightUpAccentBrush}"/>
        </Style>
        <Style Selector="TextBox.launcher-query:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource LightUpTextBrush}"/>
        </Style>
    </Application.Styles>
</Application>
