<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightUpUI.ViewModels"
        x:Class="LightUpUI.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="520"
        Height="670"
        Title="LightUp 设置"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="18">
        <StackPanel Spacing="4">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="配置搜索模式和磁贴启动器的导航布局。" Opacity="0.65" FontSize="12"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="16" Background="#12000000" CornerRadius="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                <StackPanel Spacing="8">
                <TextBlock Text="搜索模式" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding SearchModes}"
                          SelectedItem="{Binding SelectedSearchMode, Mode=TwoWay}"/>
                <TextBlock Text="简约模式：只搜索已加入磁贴的入口。&#x0a;完整模式：加入桌面/开始菜单、PATH 程序和内建动作。"
                           Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="分类导航位置" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding CategoryNavigationPlacements}"
                              SelectedItem="{Binding SelectedCategoryNavigationPlacement, Mode=TwoWay}"/>
                    <TextBlock Text="左侧：分类固定在窗口左边。&#x0a;顶部：分类以横向列表显示，为磁贴区域腾出完整宽度。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="搜索结果数量" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{CompiledBinding ResultLimits}"
                              SelectedItem="{CompiledBinding SelectedMaxResults, Mode=TwoWay}"/>
                    <TextBlock Text="输入搜索时最多显示该数量的结果；空搜索仍最多显示 10 项常用入口。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="简约模式搜索范围" FontWeight="SemiBold"/>
                    <CheckBox Content="搜索所有磁贴分类"
                              IsChecked="{CompiledBinding SearchAllTileCategories, Mode=TwoWay}"/>
                    <TextBlock Text="关闭后，简约模式只搜索磁贴启动器当前选中的分类。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="搜索栏全局快捷键" FontWeight="SemiBold"/>
                    <TextBox Text="{CompiledBinding SearchHotkey, Mode=TwoWay}"
                             PlaceholderText="例如 alt+space"/>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="磁贴启动器全局快捷键" FontWeight="SemiBold"/>
                    <TextBox Text="{CompiledBinding TileLauncherHotkey, Mode=TwoWay}"
                             PlaceholderText="例如 alt+shift+space"/>
                    <TextBlock Text="支持 Ctrl、Alt、Shift、Win 与字母、数字、F1–F24、Space、Enter、Tab、Esc；两个入口不能重复。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="2">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.7"/>
            <Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveCommand}" Padding="18,8"/>
        </DockPanel>
    </Grid>
</Window>
