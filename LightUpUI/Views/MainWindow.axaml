<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightUpUI.ViewModels"
        xmlns:fluent="using:FluentIcons.Avalonia"
        xmlns:icon="using:FluentIcons.Common"
        x:Class="LightUpUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="680"
        Height="460"
        MinHeight="180"
        MaxHeight="620"
        Title="LightUp"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="False"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="#E61B1B1B"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource LightUpWindowBrush}"
            BorderBrush="{DynamicResource LightUpBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">
        <Border.BoxShadow>
            <BoxShadows>0 12 36 0 #90000000</BoxShadows>
        </Border.BoxShadow>

        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" PointerPressed="TitleBar_PointerPressed" Background="Transparent" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="LightUp" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource LightUpTextMutedBrush}"/>
                    <Border x:Name="TopmostStatus" IsVisible="False" Background="{DynamicResource LightUpAccentSoftBrush}" CornerRadius="5" Padding="6,2">
                        <TextBlock Text="置顶中" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource LightUpAccentBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Classes="launcher-chrome" x:Name="TopmostButton" Click="ToggleTopmost_Click" ToolTip.Tip="置顶">
                        <fluent:FluentIcon x:Name="TopmostIcon" Icon="{x:Static icon:Icon.Pin}" Width="15" Height="15" Foreground="{DynamicResource LightUpTextMutedBrush}"/>
                    </Button>
                    <Button Classes="launcher-chrome" Click="Collapse_Click" ToolTip.Tip="收起窗口">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowMinimize}" Width="15" Height="15"/>
                    </Button>
                    <Button Classes="launcher-chrome" Click="Close_Click" ToolTip.Tip="关闭窗口">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Dismiss}" Width="15" Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="52" Background="{DynamicResource LightUpSurfaceBrush}" BorderBrush="{DynamicResource LightUpBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource LightUpAccentSoftBrush}">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Search}" Width="16" Height="16" Foreground="{DynamicResource LightUpAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox Grid.Column="1" x:Name="QueryBox"
                             Text="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="搜索应用、程序或快捷方式..."
                             Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontSize="17" FontWeight="SemiBold" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource LightUpSurfaceBrush}" CornerRadius="6" Padding="7,4">
                            <TextBlock Text="{Binding SearchModeLabel}" Foreground="{DynamicResource LightUpTextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                        </Border>
                        <Button Classes="launcher-chrome" Click="ClearQuery_Click" ToolTip.Tip="清空搜索">
                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Dismiss}" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource LightUpHoverBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,9" CornerRadius="10" PointerPressed="Result_PointerPressed">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource LightUpAccentSoftBrush}">
                                        <fluent:FluentIcon Icon="{Binding Kind, Converter={StaticResource LauncherItemIconConverter}}" Width="18" Height="18" Foreground="{DynamicResource LightUpAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource LightUpTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource LightUpTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource LightUpSurfaceBrush}" CornerRadius="5" Padding="6,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind, Converter={StaticResource LauncherItemLabelConverter}}" Foreground="{DynamicResource LightUpTextFaintBrush}" FontSize="9" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource LightUpTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsSearching}"/>
                <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom" IsVisible="{Binding IsSearching}"/>
            </Grid>

            <TextBlock Grid.Row="3" Text="↑↓ 选择    Enter 启动    Esc 关闭" Foreground="{DynamicResource LightUpTextFaintBrush}" FontSize="10" HorizontalAlignment="Right"/>
        </Grid>
    </Border>
</Window>
