<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightUpUI.ViewModels"
        xmlns:tiles="using:LightUpUI.Models.Tiles"
        xmlns:fluent="using:FluentIcons.Avalonia"
        xmlns:icon="using:FluentIcons.Common"
        x:Class="LightUpUI.Views.TileLauncherWindow"
        x:DataType="vm:TileLauncherViewModel"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="420"
        Title="LightUp 磁贴启动器"
        WindowDecorations="None"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="False"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="#E61B1B1B"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.DragLeave="Window_DragLeave"
        DragDrop.Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Deactivated="Window_Deactivated">

    <Window.Styles>
        <Style Selector="Border.category-drop-target">
            <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.tile-card.tile-drop-before">
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 -3 0 0 #FF75A3FF"/>
        </Style>
        <Style Selector="Border.tile-card.tile-drop-after">
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 3 0 0 #FF75A3FF"/>
        </Style>
        <Style Selector="Border.external-drop-overlay">
            <Setter Property="Background" Value="#D91B2A3D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.external-drop-overlay.drop-invalid">
            <Setter Property="Background" Value="#D93D1D25"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LightUpDangerBrush}"/>
        </Style>
    </Window.Styles>

    <Border Background="{DynamicResource LightUpWindowBrush}"
            BorderBrush="{DynamicResource LightUpBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18">
        <Border.BoxShadow>
            <BoxShadows>0 12 36 0 #90000000</BoxShadows>
        </Border.BoxShadow>

        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  Background="Transparent"
                  Cursor="SizeAll"
                  PointerPressed="TitleBar_PointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource LightUpAccentSoftBrush}">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Apps}"
                                            Width="16"
                                            Height="16"
                                            Foreground="{DynamicResource LightUpAccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="LightUp"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource LightUpTextBrush}"/>
                        <TextBlock Text="磁贴启动器"
                                   FontSize="10"
                                   Foreground="{DynamicResource LightUpTextMutedBrush}"/>
                    </StackPanel>
                    <Border x:Name="TopmostStatus"
                            IsVisible="False"
                            Background="{DynamicResource LightUpAccentSoftBrush}"
                            CornerRadius="6"
                            Padding="7,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Pin}"
                                                Width="11"
                                                Height="11"
                                                Foreground="{DynamicResource LightUpAccentBrush}"/>
                            <TextBlock Text="已置顶"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LightUpAccentBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="SearchShell"
                        Grid.Column="1"
                        Classes="launcher-search-shell"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="220"
                        Height="40"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <fluent:FluentIcon Grid.Column="0"
                                            Icon="{x:Static icon:Icon.Search}"
                                            Width="15"
                                            Height="15"
                                            Foreground="{DynamicResource LightUpAccentBrush}"
                                            VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Classes="launcher-query"
                                 x:Name="SearchBox"
                                 Text="{CompiledBinding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="搜索当前分类的磁贴"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource LightUpTextBrush}"
                                 CaretBrush="{DynamicResource LightUpAccentBrush}"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"
                                 KeyboardNavigation.TabIndex="0"/>
                        <Button Grid.Column="2"
                                Classes="launcher-chrome launcher-search-clear"
                                Click="ClearSearch_Click"
                                ToolTip.Tip="清空搜索"
                                AutomationProperties.Name="清空磁贴搜索">
                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Dismiss}"
                                                Width="13"
                                                Height="13"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Background="{DynamicResource LightUpSurfaceBrush}"
                            CornerRadius="6"
                            Padding="7,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="Alt + Shift + Space"
                                   FontSize="9"
                                   Foreground="{DynamicResource LightUpTextFaintBrush}"/>
                    </Border>
                    <Button Classes="launcher-chrome"
                            x:Name="TopmostButton"
                            Click="ToggleTopmost_Click"
                            ToolTip.Tip="置顶窗口"
                            AutomationProperties.Name="切换窗口置顶">
                        <fluent:FluentIcon x:Name="TopmostIcon"
                                            Icon="{x:Static icon:Icon.PinOff}"
                                            Width="15"
                                            Height="15"/>
                    </Button>
                    <Button Classes="launcher-chrome"
                            Click="Collapse_Click"
                            ToolTip.Tip="收起窗口"
                            AutomationProperties.Name="收起磁贴启动器">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowMinimize}"
                                            Width="15"
                                            Height="15"/>
                    </Button>
                    <Button Classes="launcher-chrome"
                            Click="Close_Click"
                            ToolTip.Tip="关闭窗口"
                            AutomationProperties.Name="关闭磁贴启动器">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Dismiss}"
                                            Width="15"
                                            Height="15"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="TileWorkspace"
                  Grid.Row="1"
                  RowDefinitions="Auto,*"
                  ColumnDefinitions="204,*"
                  ColumnSpacing="16">

                <Border x:Name="TopCategoryNavigation"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{CompiledBinding IsTopNavigation}"
                        Background="{DynamicResource LightUpSurfaceBrush}"
                        BorderBrush="{DynamicResource LightUpBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="分类"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LightUpTextBrush}"/>
                            <TextBlock Text="{CompiledBinding Categories.Count, StringFormat='共 {0} 个'}"
                                       FontSize="9"
                                       Foreground="{DynamicResource LightUpTextFaintBrush}"/>
                        </StackPanel>
                        <ListBox Grid.Column="1"
                                 ItemsSource="{CompiledBinding Categories}"
                                 SelectedItem="{CompiledBinding SelectedCategory, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Height="38"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border.category-top-item">
                                    <Setter Property="Background" Value="{DynamicResource LightUpHoverBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.category-top-item">
                                    <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:focus-visible Border.category-top-item">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="tiles:TileCategory">
                                    <Border Classes="category-top-item"
                                            Padding="10,7"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            DragDrop.AllowDrop="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Folder}"
                                                                Width="14"
                                                                Height="14"
                                                                Foreground="{DynamicResource LightUpTextMutedBrush}"
                                                                VerticalAlignment="Center"/>
                                            <TextBlock Text="{CompiledBinding Name}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource LightUpTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBox Classes="launcher-field" Width="128"
                                     Text="{CompiledBinding NewCategoryName, Mode=TwoWay}"
                                     PlaceholderText="新分类"
                                     FontSize="11"
                                     Padding="8,6"
                                     Background="{DynamicResource LightUpWindowBrush}"
                                     BorderBrush="{DynamicResource LightUpBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Foreground="{DynamicResource LightUpTextBrush}"
                                     KeyDown="NewCategory_KeyDown"/>
                            <Button Classes="launcher-primary launcher-icon-button"
                                    Command="{CompiledBinding AddNewCategoryCommand}"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    ToolTip.Tip="添加分类"
                                    AutomationProperties.Name="添加分类">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Add}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LeftCategoryNavigation"
                        Grid.Row="1"
                        Grid.Column="0"
                        IsVisible="{CompiledBinding IsLeftNavigation}"
                        Background="{DynamicResource LightUpSurfaceBrush}"
                        BorderBrush="{DynamicResource LightUpBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="10">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                        <StackPanel Grid.Row="0" Spacing="2" Margin="3,2,3,0">
                            <TextBlock Text="分类"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LightUpTextBrush}"/>
                            <TextBlock Text="按场景整理你的入口"
                                       FontSize="10"
                                       Foreground="{DynamicResource LightUpTextMutedBrush}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Classes="launcher-field" x:Name="NewCategoryBox"
                                     Text="{CompiledBinding NewCategoryName, Mode=TwoWay}"
                                     PlaceholderText="新分类"
                                     FontSize="11"
                                     Padding="8,6"
                                     Background="{DynamicResource LightUpWindowBrush}"
                                     BorderBrush="{DynamicResource LightUpBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Foreground="{DynamicResource LightUpTextBrush}"
                                     KeyboardNavigation.TabIndex="1"
                                     KeyDown="NewCategory_KeyDown"/>
                            <Button Grid.Column="1"
                                    Classes="launcher-primary launcher-icon-button"
                                    Command="{CompiledBinding AddNewCategoryCommand}"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    ToolTip.Tip="添加分类"
                                    AutomationProperties.Name="添加分类">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Add}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="2"
                                 ItemsSource="{CompiledBinding Categories}"
                                 SelectedItem="{CompiledBinding SelectedCategory, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyboardNavigation.TabIndex="2">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border.category-item">
                                    <Setter Property="Background" Value="{DynamicResource LightUpHoverBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.category-item">
                                    <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:focus-visible Border.category-item">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="tiles:TileCategory">
                                    <Border Classes="category-item"
                                            Padding="10,9"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="Transparent"
                                            DragDrop.AllowDrop="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Folder}"
                                                                Width="15"
                                                                Height="15"
                                                                Foreground="{DynamicResource LightUpTextMutedBrush}"
                                                                VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{CompiledBinding Name}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource LightUpTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{CompiledBinding Items.Count}"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource LightUpTextFaintBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <StackPanel Grid.Row="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{CompiledBinding SelectedCategory.Name}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource LightUpTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                            <TextBlock Text="拖入文件、文件夹、快捷方式或 HTTP(S) 地址，也可以使用右侧按钮添加"
                                       FontSize="11"
                                       Foreground="{DynamicResource LightUpTextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding MoveSelectedCategoryUpCommand}"
                                    IsEnabled="{CompiledBinding CanMoveSelectedCategoryUp}"
                                    ToolTip.Tip="上移当前分类"
                                    AutomationProperties.Name="上移当前分类">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowUp}" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding MoveSelectedCategoryDownCommand}"
                                    IsEnabled="{CompiledBinding CanMoveSelectedCategoryDown}"
                                    ToolTip.Tip="下移当前分类"
                                    AutomationProperties.Name="下移当前分类">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowDown}" Width="14" Height="14"/>
                            </Button>
                            <TextBox Classes="launcher-field" x:Name="CategoryNameBox"
                                     Width="112"
                                     Text="{CompiledBinding EditedCategoryName, Mode=TwoWay}"
                                     IsEnabled="{CompiledBinding CanManageSelectedCategory}"
                                     PlaceholderText="分类名称"
                                     FontSize="11"
                                     Padding="8,6"
                                     Background="{DynamicResource LightUpWindowBrush}"
                                     BorderBrush="{DynamicResource LightUpBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Foreground="{DynamicResource LightUpTextBrush}"
                                     ToolTip.Tip="重命名当前分类"
                                     AutomationProperties.Name="当前分类名称"
                                     KeyDown="RenameCategory_KeyDown"/>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding RenameSelectedCategoryCommand}"
                                    IsEnabled="{CompiledBinding CanManageSelectedCategory}"
                                    ToolTip.Tip="保存分类名称"
                                    AutomationProperties.Name="保存分类名称">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Edit}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                            <Button Classes="launcher-danger"
                                    Command="{CompiledBinding RequestCategoryRemovalCommand}"
                                    IsEnabled="{CompiledBinding CanManageSelectedCategory}"
                                    Padding="8,6"
                                    ToolTip.Tip="按下方策略删除当前分类"
                                    AutomationProperties.Name="删除当前分类">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Delete}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                            <Button Classes="launcher-primary"
                                    Click="Add_Click"
                                    IsEnabled="{CompiledBinding CanEdit}"
                                    Padding="12,8"
                                    ToolTip.Tip="选择文件或文件夹"
                                    AutomationProperties.Name="添加入口">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.Add}" Width="14" Height="14"/>
                                    <TextBlock Text="添加入口" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Border Grid.Row="2"
                                IsVisible="{CompiledBinding CanManageSelectedCategory}"
                                Background="{DynamicResource LightUpSurfaceBrush}"
                                BorderBrush="{DynamicResource LightUpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,5">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="删除后处理"
                                           FontSize="10"
                                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Width="106"
                                          Classes="launcher-field"
                                          ItemsSource="{CompiledBinding CategoryRemovalModes}"
                                          SelectedItem="{CompiledBinding SelectedCategoryRemovalMode, Mode=TwoWay}"
                                          FontSize="10.5"
                                          ToolTip.Tip="选择删除分类后如何处理其中的入口"
                                          AutomationProperties.Name="删除分类后的入口处理方式">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="tiles:CategoryRemovalModeOption">
                                            <TextBlock Text="{CompiledBinding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="入口移至"
                                           IsVisible="{CompiledBinding IsMovingCategoryItems}"
                                           FontSize="10"
                                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Classes="launcher-field"
                                          Width="126"
                                          IsVisible="{CompiledBinding IsMovingCategoryItems}"
                                          ItemsSource="{CompiledBinding CategoryRemovalDestinationCategories}"
                                          SelectedItem="{CompiledBinding CategoryRemovalDestinationCategory, Mode=TwoWay}"
                                          PlaceholderText="未分类（默认）"
                                          FontSize="10.5"
                                          ToolTip.Tip="选择接收当前分类入口的目标分类"
                                          AutomationProperties.Name="删除分类的入口迁移目标">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="tiles:TileCategory">
                                            <TextBlock Text="{CompiledBinding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="4"
                                            IsVisible="{CompiledBinding IsDeletingCategoryItems}">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.Delete}"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="{DynamicResource LightUpDangerBrush}"
                                                        VerticalAlignment="Center"/>
                                    <TextBlock Text="分类中的入口将被删除"
                                               FontSize="10"
                                               Foreground="{DynamicResource LightUpDangerBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3"
                                IsVisible="{CompiledBinding IsCategoryRemovalConfirmationVisible}"
                                Background="{DynamicResource LightUpDangerSoftBrush}"
                                BorderBrush="{DynamicResource LightUpDangerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.Delete}"
                                                        Width="13"
                                                        Height="13"
                                                        Foreground="{DynamicResource LightUpDangerBrush}"
                                                        VerticalAlignment="Center"/>
                                    <TextBlock Text="{CompiledBinding CategoryRemovalConfirmationText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource LightUpTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Classes="launcher-chrome"
                                            Command="{CompiledBinding CancelCategoryRemovalCommand}"
                                            ToolTip.Tip="取消删除分类"
                                            AutomationProperties.Name="取消删除分类">
                                        <TextBlock Text="取消" FontSize="10"/>
                                    </Button>
                                    <Button Classes="launcher-danger"
                                            Command="{CompiledBinding ConfirmCategoryRemovalCommand}"
                                            Padding="8,5"
                                            ToolTip.Tip="确认删除当前分类"
                                            AutomationProperties.Name="确认删除当前分类">
                                        <TextBlock Text="确认删除" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ListBox x:Name="TileList"
                                 ItemsSource="{CompiledBinding VisibleItems}"
                                 SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 IsVisible="{CompiledBinding HasVisibleItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.BringIntoViewOnFocusChange="True"
                                 KeyboardNavigation.TabIndex="3">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="Width" Value="156"/>
                                    <Setter Property="Height" Value="132"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBox.tile-density-comfortable ListBoxItem">
                                    <Setter Property="Width" Value="188"/>
                                    <Setter Property="Height" Value="160"/>
                                    <Setter Property="Margin" Value="5"/>
                                </Style>
                                <Style Selector="ListBox.tile-density-comfortable Border.tile-card">
                                    <Setter Property="Padding" Value="14"/>
                                </Style>
                                <Style Selector="ListBox.tile-density-comfortable Border.tile-card > Grid">
                                    <Setter Property="RowSpacing" Value="9"/>
                                </Style>
                                <Style Selector="ListBox.tile-density-comfortable Border.tile-icon-box">
                                    <Setter Property="Width" Value="56"/>
                                    <Setter Property="Height" Value="56"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover Border.tile-card">
                                    <Setter Property="Background" Value="{DynamicResource LightUpHoverBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpBorderBrushStrong}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.tile-card">
                                    <Setter Property="Background" Value="{DynamicResource LightUpSelectionBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:focus-visible Border.tile-card">
                                    <Setter Property="BorderBrush" Value="{DynamicResource LightUpAccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel x:Name="TileWrapPanel"
                                               Orientation="Horizontal"
                                               ItemWidth="156"
                                               ItemHeight="132"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="tiles:TileItem">
                            <Border Classes="tile-card"
                                    Padding="12"
                                    CornerRadius="12"
                                    Background="{DynamicResource LightUpSurfaceStrongBrush}"
                                    BorderBrush="{DynamicResource LightUpBorderBrush}"
                                    BorderThickness="1"
                                    DragDrop.AllowDrop="True"
                                    PointerPressed="Tile_PointerPressed">
                                        <Border.ContextMenu>
                                            <ContextMenu Classes="launcher-context-menu">
                                                <MenuItem Header="打开"
                                                          Click="ContextOpen_Click"
                                                          AutomationProperties.Name="打开磁贴入口">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Open}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="重命名"
                                                          Click="ContextRename_Click"
                                                          AutomationProperties.Name="重命名磁贴入口">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Edit}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="编辑备注"
                                                          Click="ContextNotes_Click"
                                                          AutomationProperties.Name="编辑磁贴备注">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Edit}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="打开所在位置"
                                                          Click="ContextReveal_Click"
                                                          AutomationProperties.Name="打开磁贴所在位置">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.FolderOpen}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="重新选择目标"
                                                          Click="ContextRetarget_Click"
                                                          IsEnabled="{CompiledBinding HasTargetIssue}"
                                                          AutomationProperties.Name="重新选择磁贴目标">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.FolderOpen}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="图标"
                                                          AutomationProperties.Name="管理磁贴图标">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Image}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                    <MenuItem Header="选择自定义图标..."
                                                              Click="ContextChooseIcon_Click"
                                                              AutomationProperties.Name="选择磁贴自定义图标">
                                                        <MenuItem.Icon>
                                                            <fluent:FluentIcon Icon="{x:Static icon:Icon.ImageAdd}" Width="14" Height="14"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="恢复默认图标"
                                                              Click="ContextClearIcon_Click"
                                                              IsEnabled="{CompiledBinding HasCustomIcon}"
                                                              AutomationProperties.Name="恢复磁贴默认图标">
                                                        <MenuItem.Icon>
                                                            <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowReset}" Width="14" Height="14"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuItem>
                                                <MenuItem Header="移动到分类"
                                                          Click="ContextMove_Click"
                                                          AutomationProperties.Name="移动磁贴入口">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowRight}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="移除入口"
                                                          Click="ContextRemove_Click"
                                                          AutomationProperties.Name="移除磁贴入口">
                                                    <MenuItem.Icon>
                                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Delete}" Width="14" Height="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7">
                                            <Border Classes="tile-icon-box"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource LightUpAccentSoftBrush}"
                                                    HorizontalAlignment="Center">
                                                <Grid>
                                                    <fluent:FluentIcon Icon="{CompiledBinding Kind, Converter={StaticResource TileItemIconConverter}}"
                                                                        Width="20"
                                                                        Height="20"
                                                                        Foreground="{DynamicResource LightUpAccentBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                    <Image Source="{CompiledBinding Converter={StaticResource TileItemNativeIconConverter}}"
                                                           Width="32"
                                                           Height="32"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="0"
                                                    Classes="launcher-tile-repair"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-5,42,0"
                                                    IsVisible="{CompiledBinding HasTargetIssue}"
                                                    ToolTip.Tip="{CompiledBinding TargetHealthMessage}"
                                                    AutomationProperties.Name="重新选择不可用入口的目标"
                                                    Click="RetargetTile_Click">
                                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Dismiss}"
                                                                    Width="11"
                                                                    Height="11"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                            </Button>
                                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{CompiledBinding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource LightUpTextBrush}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{CompiledBinding Kind, Converter={StaticResource LauncherItemLabelConverter}}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                                                           TextAlignment="Center"/>
                                                <TextBlock Text="目标不可用"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource LightUpDangerBrush}"
                                                           TextAlignment="Center"
                                                           IsVisible="{CompiledBinding HasTargetIssue}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{CompiledBinding Notes}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource LightUpTextMutedBrush}"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"/>
                                            </StackPanel>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                <TextBlock Text="{CompiledBinding LaunchCount, StringFormat='打开 {0} 次'}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="6"
                                                        Classes="tile-drag-handle"
                                                        PointerPressed="TileDragHandle_PointerPressed"
                                                        ToolTip.Tip="拖动到分类以移动入口"
                                                        AutomationProperties.Name="拖动磁贴入口"
                                                        Cursor="SizeAll">
                                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.Drag}"
                                                                        Width="13"
                                                                        Height="13"
                                                                        Foreground="{DynamicResource LightUpTextMutedBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                </Border>
                                                <Button Grid.Column="2"
                                                        Classes="launcher-tile-remove"
                                                        Click="RemoveTile_Click"
                                                        CommandParameter="{CompiledBinding}"
                                                        ToolTip.Tip="移除入口"
                                                        AutomationProperties.Name="移除入口">
                                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.Delete}"
                                                                        Width="12"
                                                                        Height="12"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border IsVisible="{CompiledBinding ShowEmptyState}"
                                Background="{DynamicResource LightUpSurfaceBrush}"
                                BorderBrush="{DynamicResource LightUpBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Margin="4"
                                Padding="24">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource LightUpAccentSoftBrush}" HorizontalAlignment="Center">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.AppsAddIn}"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="{DynamicResource LightUpAccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{CompiledBinding EmptyStateText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LightUpTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="拖放文件、快捷方式或 HTTP(S) 地址到这里，也可点击下方按钮选择文件"
                                           FontSize="11"
                                           Foreground="{DynamicResource LightUpTextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <Button Classes="launcher-primary"
                                        Click="Add_Click"
                                        IsEnabled="{CompiledBinding CanEdit}"
                                        Padding="13,8"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Add}" Width="14" Height="14"/>
                                        <TextBlock Text="选择入口"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{CompiledBinding IsLoading}"
                                Background="{DynamicResource LightUpSurfaceBrush}"
                                CornerRadius="14"
                                Margin="4"
                                Padding="24">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                                <ProgressBar Width="180" Height="3" IsIndeterminate="True"/>
                                <TextBlock Text="正在加载磁贴…"
                                           FontSize="11"
                                           Foreground="{DynamicResource LightUpTextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" MinHeight="22">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <fluent:FluentIcon Icon="{x:Static icon:Icon.Info}"
                                                Width="13"
                                                Height="13"
                                                Foreground="{DynamicResource LightUpTextFaintBrush}"
                                                IsVisible="{CompiledBinding HasStatus}"/>
                            <TextBlock Text="{CompiledBinding StatusText}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource LightUpTextMutedBrush}"
                                       IsVisible="{CompiledBinding HasStatus}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding UndoLastRemovalCommand}"
                                    IsVisible="{CompiledBinding CanUndoLastRemoval}"
                                    ToolTip.Tip="撤销移除"
                                    AutomationProperties.Name="撤销移除入口">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowLeft}" Width="12" Height="12"/>
                                    <TextBlock Text="撤销" FontSize="10"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding UndoLastCategoryRemovalCommand}"
                                    IsVisible="{CompiledBinding CanUndoLastCategoryRemoval}"
                                    ToolTip.Tip="撤销删除分类"
                                    AutomationProperties.Name="撤销删除分类">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowLeft}" Width="12" Height="12"/>
                                    <TextBlock Text="撤销分类删除" FontSize="10"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    VerticalAlignment="Center"
                                    IsVisible="{CompiledBinding HasSelectedItem}">
                            <TextBox Classes="launcher-field" x:Name="TileTitleBox"
                                     Width="120"
                                     Text="{CompiledBinding EditedTileTitle, Mode=TwoWay}"
                                     IsEnabled="{CompiledBinding CanRenameSelectedItem}"
                                     FontSize="10.5"
                                     Background="{DynamicResource LightUpWindowBrush}"
                                     BorderBrush="{DynamicResource LightUpBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource LightUpTextBrush}"
                                     ToolTip.Tip="重命名选中入口（F2）"
                                     AutomationProperties.Name="选中入口名称"
                                     KeyDown="RenameTile_KeyDown"/>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding RenameSelectedItemCommand}"
                                    IsEnabled="{CompiledBinding CanRenameSelectedItem}"
                                    ToolTip.Tip="保存入口名称"
                                    AutomationProperties.Name="保存入口名称">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Edit}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                            <TextBox Classes="launcher-field" x:Name="TileNotesBox"
                                     Width="142"
                                     Text="{CompiledBinding EditedTileNotes, Mode=TwoWay}"
                                     IsEnabled="{CompiledBinding CanEditSelectedItemNotes}"
                                     FontSize="10.5"
                                     Background="{DynamicResource LightUpWindowBrush}"
                                     BorderBrush="{DynamicResource LightUpBorderBrush}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource LightUpTextBrush}"
                                     ToolTip.Tip="编辑选中入口备注"
                                     AutomationProperties.Name="选中入口备注"
                                     KeyDown="SaveNotes_KeyDown"/>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding SaveSelectedItemNotesCommand}"
                                    IsEnabled="{CompiledBinding CanEditSelectedItemNotes}"
                                    ToolTip.Tip="保存入口备注"
                                    AutomationProperties.Name="保存入口备注">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.Edit}" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding MoveSelectedItemUpCommand}"
                                    IsEnabled="{CompiledBinding CanMoveSelectedItemUp}"
                                    ToolTip.Tip="上移选中入口"
                                    AutomationProperties.Name="上移选中入口">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowUp}" Width="14" Height="14"/>
                            </Button>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding MoveSelectedItemDownCommand}"
                                    IsEnabled="{CompiledBinding CanMoveSelectedItemDown}"
                                    ToolTip.Tip="下移选中入口"
                                    AutomationProperties.Name="下移选中入口">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowDown}" Width="14" Height="14"/>
                            </Button>
                            <TextBlock Text="移动至"
                                       FontSize="10"
                                       Foreground="{DynamicResource LightUpTextFaintBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Classes="launcher-field" Width="108"
                                      x:Name="MoveCategoryBox"
                                      ItemsSource="{CompiledBinding MoveDestinationCategories}"
                                      SelectedItem="{CompiledBinding MoveDestinationCategory, Mode=TwoWay}"
                                      FontSize="10.5"
                                      Padding="6,3"
                                      ToolTip.Tip="选择目标分类"
                                      AutomationProperties.Name="移动目标分类"
                                      KeyboardNavigation.TabIndex="4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="tiles:TileCategory">
                                        <TextBlock Text="{CompiledBinding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="launcher-chrome"
                                    Command="{CompiledBinding MoveSelectedItemCommand}"
                                    IsEnabled="{CompiledBinding CanMoveSelectedItem}"
                                    ToolTip.Tip="移动选中的入口"
                                    AutomationProperties.Name="移动选中入口">
                                <fluent:FluentIcon Icon="{x:Static icon:Icon.ArrowRight}"
                                                    Width="14"
                                                    Height="14"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <ProgressBar Width="70" Height="3" IsIndeterminate="True" IsVisible="{CompiledBinding IsSaving}"/>
                            <TextBlock Text="正在保存…"
                                       FontSize="10"
                                       Foreground="{DynamicResource LightUpTextFaintBrush}"
                                       IsVisible="{CompiledBinding IsSaving}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="单击选择 · 双击打开 · Enter 打开 · Esc 收起"
                           FontSize="10"
                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="拖放文件或 HTTP(S) 地址也可添加入口"
                           FontSize="10"
                           Foreground="{DynamicResource LightUpTextFaintBrush}"
                           VerticalAlignment="Center"/>
            </Grid>

            <Border x:Name="ExternalDropOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Classes="external-drop-overlay"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    CornerRadius="14"
                    Margin="-6">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="14"
                            Background="{DynamicResource LightUpAccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <fluent:FluentIcon Icon="{x:Static icon:Icon.Add}"
                                            Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource LightUpAccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ExternalDropMessage"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource LightUpTextBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
