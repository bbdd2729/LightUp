<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightUpUI.ViewModels"
        x:Class="LightUpUI.Views.TileLauncherWindow"
        x:DataType="vm:TileLauncherViewModel"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="420"
        Title="LightUp 磁贴启动器"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="#E61B1B1B"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource LightUpWindowBrush}" BorderBrush="{DynamicResource LightUpBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Border PointerPressed="TitleBar_PointerPressed" Background="Transparent" Padding="2,4">
                    <TextBlock Text="LightUp" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource LightUpTextBrush}" VerticalAlignment="Center"/>
                </Border>
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="搜索当前分类..."
                         MaxWidth="360"
                         HorizontalAlignment="Right"
                         Background="{DynamicResource LightUpSurfaceBrush}" BorderBrush="{DynamicResource LightUpBorderBrush}" BorderThickness="1" CornerRadius="9"
                         Foreground="{DynamicResource LightUpTextBrush}" CaretBrush="{DynamicResource LightUpTextBrush}" Padding="10,7"/>
                <Border Grid.Column="2" Background="{DynamicResource LightUpSurfaceBrush}" CornerRadius="6" Padding="7,4" VerticalAlignment="Center">
                    <TextBlock Text="Alt + Shift + Space" Foreground="{DynamicResource LightUpTextFaintBrush}" FontSize="10" VerticalAlignment="Center"/>
                </Border>
                <Button Classes="launcher-chrome" Grid.Column="3" x:Name="TopmostButton" Content="📌" Click="ToggleTopmost_Click" ToolTip.Tip="置顶" Width="30" Height="30"/>
                <Button Classes="launcher-chrome" Grid.Column="4" Content="—" Click="Collapse_Click" ToolTip.Tip="收起窗口" Width="30" Height="30"/>
                <Button Classes="launcher-chrome" Grid.Column="5" Content="×" Click="Close_Click" ToolTip.Tip="关闭窗口" Width="30" Height="30"/>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="{DynamicResource LightUpSurfaceBrush}" CornerRadius="12" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                            <TextBlock Text="分类" Foreground="{DynamicResource LightUpTextMutedBrush}" FontSize="11" Margin="4,2,4,0"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                <TextBox Text="{Binding NewCategoryName, Mode=TwoWay}"
                                         PlaceholderText="新分类"
                                         FontSize="11"
                                         Padding="7,5"
                                         Background="{DynamicResource LightUpSurfaceBrush}"
                                         BorderBrush="{DynamicResource LightUpBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="7"
                                         Foreground="{DynamicResource LightUpTextBrush}"/>
                                <Button Classes="launcher-primary" Grid.Column="1"
                                        Content="＋"
                                        Command="{Binding AddNewCategoryCommand}"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        Background="#303B82F6"
                                        BorderThickness="0"
                                        Foreground="White"/>
                            </Grid>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource LightUpTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SelectedCategory.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource LightUpTextBrush}"/>
                            <TextBlock Text="将文件、文件夹或快捷方式拖到这里" Foreground="{DynamicResource LightUpTextMutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Classes="launcher-primary" Grid.Column="1" Content="＋ 添加入口" Click="Add_Click" Padding="12,7"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="150" ItemHeight="118" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Padding="12" CornerRadius="12" Background="{DynamicResource LightUpSurfaceBrush}"
                                            PointerPressed="Tile_PointerPressed">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource LightUpAccentSoftBrush}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource LauncherItemGlyphConverter}}" Foreground="{DynamicResource LightUpAccentBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource LightUpTextBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource LauncherItemLabelConverter}}" Foreground="{DynamicResource LightUpTextFaintBrush}" FontSize="10" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
