<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LightUpUI.ViewModels"
        x:Class="LightUpUI.Views.TileLauncherWindow"
        x:DataType="vm:TileLauncherViewModel"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="420"
        Title="LightUp 磁贴启动器"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur,Transparent"
        TransparencyBackgroundFallback="#E61B1B1B"
        DragDrop.DragOver="Window_DragOver"
        DragDrop.Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Border Background="#E91A1A1A" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="14">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="LightUp" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="搜索当前分类..."
                         MaxWidth="360"
                         HorizontalAlignment="Right"
                         Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="9"
                         Foreground="White" CaretBrush="White" Padding="10,7"/>
                <TextBlock Grid.Column="2" Text="Alt + Shift + Space" Foreground="#66FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="×" Click="Close_Click" Width="30" Height="30" Background="#18FFFFFF" BorderThickness="0"/>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="12" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="分类" Foreground="#99FFFFFF" FontSize="11" Margin="4,2,4,8"/>
                        <ListBox ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SelectedCategory.Name}" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="将文件、文件夹或快捷方式拖到这里" Foreground="#88FFFFFF" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ 添加入口" Click="Add_Click" Padding="12,7" Background="#303B82F6" BorderThickness="0" Foreground="White"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="150" ItemHeight="118" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Padding="12" CornerRadius="12" Background="#20FFFFFF"
                                            PointerPressed="Tile_PointerPressed">
                                        <StackPanel Spacing="8" VerticalAlignment="Center">
                                            <Border Width="42" Height="42" CornerRadius="11" Background="#303B82F6" HorizontalAlignment="Center">
                                                <TextBlock Text="◆" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Kind}" Foreground="#77FFFFFF" FontSize="10" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
